# ----------------------------------------------------
# COVRA Launch Event Ticketing - Environment Variables
# ----------------------------------------------------

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paymob Integration Credentials
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_INTEGRATION_ID=your-integration-id
PAYMOB_IFRAME_ID=your-iframe-id
PAYMOB_HMAC_SECRET=your-hmac-secret

# Resend Email Service
RESEND_API_KEY=re_your_resend_api_key

# App Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional Secret for QR signature if different from HMAC secret
QR_SIGNING_SECRET=covra-cryptographic-ticket-secret-key-2026
